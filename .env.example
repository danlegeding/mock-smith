# 复制成 .env 再填值：Copy-Item .env.example .env
# 注意：.env 已在 .gitignore 里，别提交真实密码/密钥。

# ===== 数据库（docker-compose 读取；端口 5434 是映射到宿主机的）=====
POSTGRES_USER=interview
POSTGRES_PASSWORD=change_me
POSTGRES_DB=interview_agent

# ===== Python 连库（与上面同一套账号，@ 要转义成 %40）=====
# 只在容器第一次创建数据卷时才会用 POSTGRES_* 建库建用户；改了密码要 docker compose down -v 重建
DATABASE_URL=postgresql://interview:change_me@localhost:5434/interview_agent

# ===== 模型（OpenAI 兼容网关）=====
# 三个值都必填：key、base_url（要带 /v1）、模型名
CLOSEAI_API_KEY=
CLOSEAI_API_URL=https://api.openai-proxy.org/v1
LLM_MODEL=gpt-5.4-mini
